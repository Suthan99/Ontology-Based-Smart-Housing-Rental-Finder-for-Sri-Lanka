        <rdfs:domain rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#Tenant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#Property"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#submits -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#submits">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#Tenant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#MaintenanceRequest"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#usesService -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#usesService">
