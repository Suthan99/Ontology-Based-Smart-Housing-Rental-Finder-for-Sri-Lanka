            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#Tenant"/>
    </owl:Class>
    


