    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#monthlyRent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#monthlyRent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#Lease"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#propertySize -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#propertySize">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#Property"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


