    <!-- http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#pays -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#pays">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#Tenant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#Payment"/>
