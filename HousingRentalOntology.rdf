     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:sri-lanka-housing-rental="http://www.semanticweb.org/nethmi/ontologies/2026/sri-lanka-housing-rental#"
     xmlns:sri-lanka-housing-rental1="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental">
        <rdfs:comment>This ontology represents housing and rental management in Sri Lanka,
including tenants, landlords, properties, leases, and payments.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#hasFacility -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#hasFacility">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#Property"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#Facility"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sivasuthan/ontologies/2026/sri-lanka-housing-rental#hasLease -->

